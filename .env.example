# Frontend build configuration
# Empty keeps local FastAPI same-origin routing. Set this to the public backend URL in Vercel.
VITE_API_URL=

# Backend CORS. Use a comma-separated list of exact browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8501,http://localhost:3000,http://localhost:5173

# LLM provider: ollama or gemini
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
GEMINI_API_KEY=your_gemini_api_key_here

# OCR executables. Windows local defaults can be left unchanged in config.py.
# Linux container defaults are /usr/bin/tesseract and /usr/bin.
TESSERACT_CMD=
POPPLER_PATH=

# Temporary upload directory for a single running backend instance.
UPLOAD_DIR=data/uploads
