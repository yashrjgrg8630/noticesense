APP_NAME=NoticeSense
ENVIRONMENT=development

# --- Postgres (used by docker-compose to create the database) ---
POSTGRES_USER=noticesense
POSTGRES_PASSWORD=noticesense
POSTGRES_DB=noticesense

# --- Backend connections ---
# Inside docker-compose the hostnames are the service names (db, redis, ollama).
DATABASE_URL=postgresql+asyncpg://noticesense:noticesense@db:5432/noticesense
REDIS_URL=redis://redis:6379/0

# --- AI provider selection ---
# ollama (default, no cloud key required) or gemini
AI_PROVIDER=ollama

# Gemini (only required when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama (default provider)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# --- Uploads ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=20

# --- OCR ---
# Tesseract language codes joined with '+', e.g. eng or eng+hin
OCR_LANGUAGE=eng

# --- CORS / frontend origins allowed to call the API ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ---
# Path the browser uses; the Next.js server proxies it to API_INTERNAL_URL.
NEXT_PUBLIC_API_BASE_URL=/api
API_INTERNAL_URL=http://api:8000
